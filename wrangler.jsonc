{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "movietime",
  "main": "worker.ts",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "MovieRoom" },
      { "name": "NAVS", "class_name": "MovieNav" }
    ]
  },
  "exports": {
    "MovieRoom": { "type": "durable-object", "storage": "sqlite" },
    "MovieNav": { "type": "durable-object", "storage": "sqlite" }
  }
}
