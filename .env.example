# Local only. Copy to .env.local — never commit secrets.

# Public STUN (default is Google's public STUN if unset)
NEXT_PUBLIC_STUN_SERVER=stun:stun.l.google.com:19302

# TURN — required for many real-world NATs. Do not hardcode these in source.
NEXT_PUBLIC_TURN_SERVER=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=

# Encrypts proxied asset tokens. Set a long random string in production.
NAV_ENCRYPTION_KEY=

# Required on Vercel (or any multi-instance host) so both participants
# share signaling state. Local `next dev` / `next start` can omit this.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
