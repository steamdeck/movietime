# Local only. Copy to .env.local — never commit secrets.

# Public STUN (default is Google's public STUN if unset)
NEXT_PUBLIC_STUN_SERVER=stun:stun.l.google.com:19302

# TURN — required for many real-world NATs. Do not hardcode these in source.
NEXT_PUBLIC_TURN_SERVER=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=

# Encrypts proxied asset tokens. Required in production: asset tokens are
# time-limited but still bearer access, and without this every deploy/instance
# derives a different local key (breaking multi-instance + leaking across restarts).
# Generate with: openssl rand -hex 32
NAV_ENCRYPTION_KEY=

# Optional allowlist for /api/follow cross-origin callers (comma-separated exact
# origins). Same-origin (the proxied pages themselves) always works. Leave empty
# unless you serve the viewer from another origin.
ALLOWED_VIEW_ORIGINS=

# Required on Vercel so both participants share signaling state.
# Cloudflare uses Durable Objects instead; local `next dev` can omit this.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
